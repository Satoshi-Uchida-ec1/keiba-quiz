{
  "name": "keiba-quiz",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "questions": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/build-questions.ts",
    "predev": "npm run questions -- --include-drafts",
    "dev": "next dev",
    "prebuild": "npm run questions",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "next": "16.3.6",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^24.13.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.6",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^5.0.1"
  },
  "engines": {
    "node": "24.x"
  }
}
